# Copy to backend/.env; never commit real credentials.
PORT=3000
NODE_ENV=development

# Create the database/user using README. URL-encode reserved password characters.
DATABASE_URL="mysql://tradeoff_app:YOUR_PASSWORD@127.0.0.1:3306/tradeoff"

# Web application OAuth client ID, matching frontend/local.properties.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Run in any terminal with Node.js; paste the output below:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_GENERATED_RANDOM_SECRET

# Sign up at https://app.alpaca.markets/signup
# Open Paper Trading and generate a matching key/secret pair. Backend only.
ALPACA_API_KEY_ID=YOUR_ALPACA_KEY
ALPACA_API_SECRET_KEY=YOUR_ALPACA_SECRET
