# Copy to .env.test (gitignored) for database/live-provider tests.
# Use a disposable test database: integration tests delete their fixture data.
DATABASE_URL=mysql://TEST_USER:TEST_PASSWORD@127.0.0.1:3306/tradeoff_test
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
ALPACA_API_KEY_ID=YOUR_ROTATED_ALPACA_KEY_ID
ALPACA_API_SECRET_KEY=YOUR_ROTATED_ALPACA_SECRET_KEY
# JWT_SECRET is optional: setup generates an isolated random test secret when absent.
