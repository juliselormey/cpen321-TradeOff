# Path to your Android SDK. Android Studio usually writes this for you.
sdk.dir=/path/to/Android/sdk

# Backend base URL baked into the APK at build time.
#API_BASE_URL=https://10.0.2.2:3000
API_BASE_URL=https://34.105.116.91:3000
# Google OAuth client ID.
GOOGLE_CLIENT_ID=

# Other API keys, secrets, and configurations

# Optional Android Emulator Market override: keep npm run dev:market running.
# 10.0.2.2 reaches the host loopback directly; no adb reverse is needed.
# MARKET_API_BASE_URL=http://10.0.2.2:3001/
# Optional: install beside an existing app signed by another debug key.
# DEBUG_APPLICATION_ID_SUFFIX=.marketdemo
