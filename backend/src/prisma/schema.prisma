generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  TRADER
  ADMIN
}

enum TradeType {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELLED
}

model User {
  id          String   @id @default(uuid())
  googleSub   String   @unique
  email       String   @unique
  username    String?  @unique @db.VarChar(24)
  displayName String?
  avatarUrl   String?
  role        Role     @default(TRADER)
  isBanned    Boolean  @default(false)
  createdAt   DateTime @default(now())

  account             Account?
  refreshTokens       RefreshToken[]
  sentFriendships     Friendship[] @relation("FriendshipSender")
  receivedFriendships Friendship[] @relation("FriendshipRecipient")

  positions Position[]
  trades    Trade[]
  orders    Order[]
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(uuid())
  pairKey     String           @unique @db.VarChar(73)
  senderId    String
  recipientId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  sender      User             @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User             @relation("FriendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([recipientId, status])
}

model Account {
  userId          String  @id
  cashBalance     Decimal @db.Decimal(18, 4)
  startingBalance Decimal @db.Decimal(18, 4)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Position {
  id          String   @id @default(uuid())
  userId      String
  ticker      String
  quantity    Decimal  @db.Decimal(18, 4)
  averageCost Decimal  @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
}

model Trade {
  id            String    @id @default(uuid())
  userId        String
  ticker        String
  type          TradeType
  quantity      Decimal   @db.Decimal(18, 4)
  pricePerShare Decimal   @db.Decimal(18, 4)
  totalAmount   Decimal   @db.Decimal(18, 4)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  ticker        String
  side          TradeType
  type          OrderType
  status        OrderStatus @default(PENDING)
  quantity      Decimal     @db.Decimal(18, 4)
  limitPrice    Decimal?    @db.Decimal(18, 4)
  executedPrice Decimal?    @db.Decimal(18, 4)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, ticker])
}
