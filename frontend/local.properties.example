# Merge into local.properties; preserve Android Studio's existing sdk.dir.
# Use your actual SDK path, with forward slashes on Windows. Do not quote values.
# Windows: C:/Users/YOUR_USERNAME/AppData/Local/Android/Sdk
# macOS: /Users/YOUR_USERNAME/Library/Android/sdk
sdk.dir=/path/to/Android/sdk

# Standard emulator reaches the full local HTTPS backend at 10.0.2.2.
# For a physical device use the computer's LAN IP instead.
# Copy the backend public certificate into the app as described in README.
API_BASE_URL=https://10.0.2.2:3000/
MARKET_API_BASE_URL=https://10.0.2.2:3000/

# Web application OAuth client ID, matching backend/.env; not a client secret.
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Normally leave unset; a suffix needs matching Android OAuth registration.
# DEBUG_APPLICATION_ID_SUFFIX=.marketdemo
